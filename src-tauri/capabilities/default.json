{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "LLMira main window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "stronghold:default",
    "sql:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "https://*" }
      ]
    }
  ]
}
