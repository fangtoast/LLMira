{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLMira",
  "version": "0.2.0-dev.1",
  "identifier": "com.llmira.workbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LLMira",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "个人优先的多模型 AI 客户端",
    "longDescription": "安装即用的个人 AI 客户端，支持 OpenAI-compatible Provider 扫描、连续对话、生图与可选联网搜索；团队协作为扩展功能。",
    "windows": {
      "minimumWebview2Version": "109.0.1518.0",
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"]
      },
      "wix": {
        "language": ["zh-CN", "en-US"]
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
