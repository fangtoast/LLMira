    "@fastify/jwt": "10.2.1",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "11.2.0",
    "@llmira/contracts": "*",
    "@llmira/security": "*",
    "argon2": "0.45.1",
    "bullmq": "6.1.0",
    "fastify": "5.11.3",
    "ioredis": "6.0.0",
    "postgres": "3.4.9",
    "uuid": "14.0.1",
    "zod": "4.4.3"
