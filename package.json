{
  "name": "@llmira/client",
  "version": "0.2.0-dev.1",
  "private": true,
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "brace-expansion@1": "1.1.18"
  },
  "scripts": {
    "build:packages": "npm run build --workspace @llmira/contracts && npm run build --workspace @llmira/provider-core && npm run build --workspace @llmira/security",
    "predev": "npm run build:packages",
    "dev": "next dev",
    "dev:mock-provider": "node scripts/mock-openai-compatible.mjs",
    "prebuild": "npm run build:packages",
    "build": "next build",
    "start": "serve out",
    "lint": "eslint .",
    "pretypecheck": "npm run build:packages",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:packages",
    "test": "vitest run && npm run test --workspace @llmira/provider-core && npm run test --workspace @llmira/api",
    "test:watch": "vitest",
    "test:api": "npm run test --workspace @llmira/api",
    "build:workspaces": "npm run build:packages && npm run build --workspace @llmira/api && npm run build --workspace @llmira/worker",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build:windows": "tauri build --bundles nsis,msi",
    "tauri:android:init": "tauri android init",
    "tauri:build:android": "tauri android build --apk --aab",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@llmira/contracts": "*",
    "@llmira/provider-core": "*",
    "@lobehub/icons-static-svg": "^1.94.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tabler/icons-react": "^3.35.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-sql": "2.4.0",
    "@tauri-apps/plugin-stronghold": "2.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dexie": "^4.4.2",
    "katex": "^0.16.45",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.12.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^4.8.69",
    "pino": "^9.4.0",
    "pino-pretty": "^13.1.3",
    "prismjs": "^1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^1.22.2",
    "tailwind-merge": "^3.5.0",
    "uuid": "14.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^20",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.10",
    "serve": "^14.2.5",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.9.3",
    "vitest": "4.1.0"
  }
}
