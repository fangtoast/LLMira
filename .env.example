# 浏览器开发环境；同源部署时留空，由 Caddy 反向代理 /api/v1。
NEXT_PUBLIC_TEAM_API_URL=http://localhost:4000

# 团队 API（开发值仅供本机；生产必须替换为高熵随机值）
DATABASE_URL=postgres://llmira:change-me@localhost:5432/llmira
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_MASTER_KEY=replace-with-a-long-random-master-key
PUBLIC_APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=false

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=llmira
S3_ACCESS_KEY=llmira
S3_SECRET_KEY=replace-this-object-storage-password

# 可选：团队共享知识库嵌入。切换模型后需要重建索引。
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# 可选：仅在 Worker 宿主已安装并授权隔离容器运行时时启用 stdio MCP。
# MCP_CONTAINER_RUNTIME=docker

# Docker Compose
POSTGRES_PASSWORD=replace-this-database-password
MINIO_ROOT_USER=llmira
MINIO_ROOT_PASSWORD=replace-this-minio-password
LLMIRA_SITE_ADDRESS=http://localhost
HTTP_PORT=80
HTTPS_PORT=443
